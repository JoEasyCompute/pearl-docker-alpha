PEARL_ADDRESS=prl1pYOUR_PRL_ADDRESS
PEARL_WORKER=vast-rig
PEARL_POOL_HOST=us2.alphapool.tech
PEARL_POOL_PORT=5566

# Pick one static difficulty preset for the GPUs in this rig:
# RTX 4090: PEARL_DIFFICULTY=524288
# RTX 5090: PEARL_DIFFICULTY=1048576
# RTX 6000 Ada Generation: PEARL_DIFFICULTY=524288
PEARL_DIFFICULTY=1048576

# Optional. Leave blank unless you want only specific GPU indexes, for example 0,1,2.
PEARL_DEVICES=

# Optional. Auto-detect is recommended. If troubleshooting, use ada for RTX 4090 / RTX 6000 Ada, or blackwell for RTX 5090.
# PEARL_FORCE_BACKEND=

PEARL_STATUS_INTERVAL=60
