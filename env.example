PEARL_ADDRESS=prl1pYOUR_PRL_ADDRESS
# Optional. Merge-mining address form requires alpha-miner v1.8.6+.
# You can alternatively set PEARL_ADDRESS=prl1YOUR_PRL+mdl1YOUR_MDL directly.
PEARL_MDL_ADDRESS=
PEARL_WORKER=vast-rig
PEARL_POOL_HOST=us2.alphapool.tech
PEARL_POOL_PORT=5566

# Pick one static difficulty preset for the GPUs in this rig:
# RTX 4090: PEARL_DIFFICULTY=524288
# RTX 5090: PEARL_DIFFICULTY=1048576
# RTX 6000 Ada Generation: PEARL_DIFFICULTY=524288
PEARL_DIFFICULTY=1048576

# Optional. Leave blank unless you want only specific GPU indexes, for example 0,1,2.
PEARL_DEVICES=

# Do not set PEARL_FORCE_BACKEND, PEARL_XP*, PEARL_XK_*, --gemm, --rank,
# --legacy-gemm, or --force-backend with alpha-miner v1.9.6.
# The launcher rejects manual backend/rank/GEMM controls.

# Optional GPU tuning presets. Leave disabled unless you want the container to
# fetch/read a CSV and apply best-effort nvidia-smi settings before mining.
PEARL_GPU_PRESETS_ENABLE=false
PEARL_GPU_PRESETS_URL=
PEARL_GPU_PRESETS_FILE=/etc/pearl/gpu-presets.csv
PEARL_GPU_PRESETS_ENV_FILE=/tmp/pearl-gpu-preset.env
PEARL_GPU_PRESETS_DRY_RUN=false
PEARL_GPU_PRESETS_TIMEOUT=10
PEARL_GPU_PRESETS_ALGORITHM=pearlhash
